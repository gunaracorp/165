// ============================================================
// 165 — TQN Qodiriah Naqsabandiyah Knowledge Platform
// Prisma schema — institutional knowledge base only.
//
// Layers:
//   KNOWLEDGE  : Entity, NameVariant, Relationship, ClaimSource
//   SANAD      : SanadLink (display-only, safety-gated)
//   COLLECTION : CollectionItem
//   PRESERVE   : VersionSnapshot, AuditLog (pure-append doctrine)
//   PUBLIC     : Contribution (contribution ≠ publication), Subscriber
//   ANALYTICS  : VisitEvent (privacy-first, aggregates only)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// CORE ENTITY
// One row per real-world thing. Type discriminator + shared
// trust metadata + precision-aware dating + optional geo.
// ------------------------------------------------------------
model Entity {
  id                 String   @id @default(cuid())
  globalId           String   @unique // 165-PERSON-000001, 165-SRC-000001, ...
  slug               String   @unique // canonical URL fragment
  type               String // PERSON | INSTITUTION | ORGANIZATION | PLACE | BOOK | MANUSCRIPT | DOCUMENT | MEDIA | EVENT | SANAD | RESEARCH | SOURCE | CLAIM | TRADITION | COLLECTION | TERM
  primaryName        String
  subtitle           String? // epithet / honorific / role line
  summary            String? // primary-language (EN) summary
  summaryId          String? // Indonesian summary (multilingual by design)
  summaryAr          String? // Arabic summary (multilingual by design)
  evidenceLevel      String   @default("F") // A|B|C|D|E|F
  verificationStatus String   @default("UNVERIFIED") // VERIFIED | DOCUMENTED | COMMUNITY_SUBMITTED | DISPUTED | TRADITIONAL_ACCOUNT | UNVERIFIED | WITHDRAWN
  isExampleRecord    Boolean  @default(false) // structural demo — pending Founder's archive
  // precision-aware dating (strings, not Date, so decade/circa are honest)
  startDate          String?
  startDatePrecision String? // DAY | MONTH | YEAR | DECADE | CENTURY | UNKNOWN
  endDate            String?
  endDatePrecision   String?
  // geo (for future world map)
  latitude           Float?
  longitude          Float?
  region             String? // atlas grouping e.g. "Southeast Asia"
  // extensible type-specific payload (JSON string)
  details            String?
  // privacy by design
  visibility         String   @default("PUBLIC") // PUBLIC | RESTRICTED | PRIVATE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nameVariants        NameVariant[]
  outgoingRelations   Relationship[]   @relation("RelFrom")
  incomingRelations   Relationship[]   @relation("RelTo")
  claimsAsSubject     ClaimSource[]    @relation("Claim")
  stancesAsSource     ClaimSource[]    @relation("ClaimSource")
  sanadLinks          SanadLink[]      @relation("SanadPerson")
  collectionsOwned    CollectionItem[] @relation("Collection")
  collectionsIn       CollectionItem[] @relation("CollectionItem")
  versions            VersionSnapshot[]
}

// Multilingual names, aliases, transliterations
model NameVariant {
  id       String @id @default(cuid())
  entityId String
  name     String
  language String @default("en") // id | en | ar | ln (latin)
  kind     String @default("VARIANT") // PRIMARY | ALIAS | VARIANT | TRANSLITERATION | TITLE
  note     String?

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([name])
}

// ------------------------------------------------------------
// KNOWLEDGE LAYER — typed, sourced, status-carrying relations
// Never auto-generated. Every edge is an institutional decision.
// ------------------------------------------------------------
model Relationship {
  id                 String   @id @default(cuid())
  fromEntityId       String
  toEntityId         String
  predicate          String // TEACHER_OF | STUDENT_OF | AUTHORED | ASSOCIATED_WITH | LOCATED_IN | HELD_BY | REFERENCES | APPEARS_IN | OCCURRED_IN | STUDIES | DOCUMENTS | LINEAGE_FOUNDER_OF | LINEAGE_OF | PART_OF | FOUNDED
  evidenceLevel      String   @default("F")
  verificationStatus String   @default("UNVERIFIED")
  context            String?
  sourceRef          String? // globalId of the supporting Source entity

  fromEntity Entity @relation("RelFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   Entity @relation("RelTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([predicate])
}

// Claim ↔ Source stance (support / dispute)
model ClaimSource {
  id             String @id @default(cuid())
  claimEntityId  String
  sourceEntityId String
  stance         String // SUPPORTED_BY | DISPUTED_BY
  note           String?

  claim  Entity @relation("Claim", fields: [claimEntityId], references: [id], onDelete: Cascade)
  source Entity @relation("ClaimSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)

  @@index([claimEntityId])
  @@index([sourceEntityId])
}

// ------------------------------------------------------------
// SANAD — DISPLAY ONLY. SAFETY-GATED.
// A sanad row must never be created by automation; every link
// requires an explicit source + status. The registry ships empty.
// ------------------------------------------------------------
model SanadLink {
  id                 String  @id @default(cuid())
  sanadEntityId      String // Entity of type SANAD
  order              Int
  fromName           String // transmitter (from)
  toName             String // transmitter (to)
  personEntityId     String? // optional link to a Person entity
  eraNote            String?
  evidenceLevel      String  @default("F")
  verificationStatus String  @default("UNVERIFIED")
  sourceRef          String? // required in practice; enforced by editorial policy
  context            String?

  person Entity? @relation("SanadPerson", fields: [personEntityId], references: [id])

  @@index([sanadEntityId])
}

// Collection containment
model CollectionItem {
  id           String @id @default(cuid())
  collectionId String
  itemEntityId String
  order        Int    @default(0)
  note         String?

  collection Entity @relation("Collection", fields: [collectionId], references: [id], onDelete: Cascade)
  item       Entity @relation("CollectionItem", fields: [itemEntityId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([itemEntityId])
}

// ------------------------------------------------------------
// PRESERVATION LAYER — versions & audit
// ------------------------------------------------------------
model VersionSnapshot {
  id        String   @id @default(cuid())
  entityId  String
  version   Int
  snapshot  String // JSON of entity state before/after change
  changedBy String   @default("system")
  reason    String?
  createdAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String   @default("public")
  action    String // CREATE | UPDATE | SUBMIT | STATUS_CHANGE | ...
  target    String // globalId or system target
  detail    String?
  createdAt DateTime @default(now())

  @@index([target])
}

// ------------------------------------------------------------
// CONTRIBUTION — Contribution ≠ Publication
// Workflow: SUBMITTED → SCREENING → EDITORIAL_REVIEW →
// SOURCE_REVIEW → VERIFICATION → APPROVED → PUBLISHED
//                         ↘ REJECTED | DISPUTED
// ------------------------------------------------------------
model Contribution {
  id               String   @id @default(cuid())
  reference        String   @unique // 165-SUB-2025-000001
  kind             String // KNOWLEDGE | SOURCE | BIOGRAPHY | INSTITUTION | MANUSCRIPT | ORAL_HISTORY | CORRECTION | OTHER
  title            String
  payload          String // JSON details
  submitterName    String
  submitterContact String?
  status           String   @default("SUBMITTED")
  statusNote       String?
  reviewedBy       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
}

// ------------------------------------------------------------
// Newsletter subscribers — footer "Kabar 165" (privacy-first:
// email + optional name only)
// ------------------------------------------------------------
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  source    String   @default("website")
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// VISIT EVENT — 165 Analytics (lightweight, privacy-respecting:
// no cookies, no IP storage, aggregates only)
// ------------------------------------------------------------
model VisitEvent {
  id        String   @id @default(cuid())
  path      String
  kind      String // pageview | search | entity
  term      String?
  ref       String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([kind])
  @@index([createdAt])
}

// ------------------------------------------------------------
// WIRIDIAN & BACAAN — CMS-managed readings (Qasidah, Sholawat,
// Wiridian, Dzikir). Arabic text + Latin transliteration + meaning
// in Sundanese & Indonesian + meaning-commentary (tafsir majelis).
// Every entry carries grade & status (Source-First doctrine);
// display-only — never grants/assesses spiritual legitimacy.
// ------------------------------------------------------------
model WiridEntry {
  id         String   @id @default(cuid())
  slug       String   @unique
  order      Int      @default(0)
  kind       String   @default("QASIDAH") // QASIDAH | SHOLAWAT | WIRIDIAN | DZIKIR | DUAA
  titleAr    String
  titleId    String
  titleSu    String?
  subtitleId String?
  ledeId     String?
  grade      String   @default("B") // A|B|C|D|E|F
  status     String   @default("TRADITIONAL_ACCOUNT") // DOCUMENTED | TRADITIONAL_ACCOUNT | DISPUTED | UNVERIFIED
  sourceRef  String?
  noteId     String?
  visibility String   @default("PUBLIC") // PUBLIC | PRIVATE
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  verses WiridVerse[]

  @@index([kind])
  @@index([order])
}

model WiridVerse {
  id        String  @id @default(cuid())
  entryId   String
  order     Int
  arabic    String
  latin     String?
  meaningSu String?
  meaningId String?
  tafsirId  String?
  tafsirAr  String?

  entry WiridEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, order])
}

// ------------------------------------------------------------
// CMS — WordPress-style content management ("CMS 165").
// POST = artikel blog, PAGE = halaman statis (satu tabel, diskriminator).
// Content disimpan sebagai HTML raksasa-aman dari editor visual.
// Media disimpan base64 di SQLite + disajikan via /api/cms/media/[id]/raw.
// Pengaturan situs berupa pasangan key-value (CmsSetting).
// ------------------------------------------------------------
model CmsPost {
  id          String    @id @default(cuid())
  type        String    @default("post") // post | page
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @default("")
  coverUrl    String?
  status      String    @default("draft") // draft | published | trash
  pinned      Boolean   @default(false)
  author      String    @default("Admin 165")
  categoryId  String?
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category CmsCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     CmsPostTag[]
  comments CmsComment[]

  @@index([type, status])
  @@index([status, publishedAt])
}

model CmsCategory {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  desc  String?

  posts CmsPost[]
}

model CmsTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts CmsPostTag[]
}

model CmsPostTag {
  postId String
  tagId  String

  post CmsPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  CmsTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model CmsComment {
  id        String   @id @default(cuid())
  postId    String
  name      String
  email     String?
  body      String
  status    String   @default("pending") // pending | approved | spam | trash
  createdAt DateTime @default(now())

  post CmsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
}

model CmsMedia {
  id        String   @id @default(cuid())
  filename  String
  mime      String
  size      Int
  data      String // base64 payload
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model CmsSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// CMS — PERAN & PERSONA (Dewan Pakar 46)
// Persona penulis ala WordPress: satu persona aktif dipakai
// sebagai nama penulis artikel baru. "Master" adalah peran
// gabungan seluruh 46 Dewan Pakar lintas bidang.
// ------------------------------------------------------------
model CmsPersona {
  id        String   @id @default(cuid())
  key       String   @unique // master | p-01 … p-46
  name      String
  field     String   @default("Umum")
  title     String?
  bio       String?
  icon      String   @default("sparkles")
  master    Boolean  @default(false)
  active    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
